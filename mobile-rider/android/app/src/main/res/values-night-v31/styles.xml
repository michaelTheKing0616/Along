<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash (dark): matte black with the mark in off-white. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#050505</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
