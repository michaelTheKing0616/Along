# Staging admin console env (generated by scripts/wire_staging.sh from env/staging.json)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SENTRY_DSN=https://<key>@<host>/<id>
PUBLIC_ORIGIN=

# Universal / App Links — staging uses .staging bundle/package until prod release
APPLE_TEAM_ID=
RIDER_IOS_BUNDLE_ID=ng.along.rider.staging
RIDER_ANDROID_PACKAGE=ng.along.rider.staging
ANDROID_APP_LINK_SHA256=
