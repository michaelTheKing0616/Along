{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"],
    "noImplicitAny": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": ["./**/*.ts"],
    "exclude": ["./node_modules"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "tasks": {
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read"
  }
}
