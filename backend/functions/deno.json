{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"],
    "noImplicitAny": true
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.49.1",
    "zod": "npm:zod@3.24.2"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": ["./**/*.ts"],
    "exclude": ["./node_modules"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  },
  "tasks": {
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read --allow-net"
  }
}
