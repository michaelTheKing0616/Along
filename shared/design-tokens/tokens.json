    "tier": {
      "verified": { "$type": "color", "$value": "#15803D" },
      "crowd": { "$type": "color", "$value": "#1D4ED8" },
      "candidate": { "$type": "color", "$value": "#B45309" },
      "estimate": { "$type": "color", "$value": "#6B6B6B" }
    },
    "map": {
      "puck": { "$type": "color", "$value": "#F7D117" },
      "puck-ring": { "$type": "color", "$value": "rgba(247, 209, 23, 0.25)" },
      "route-active": { "$type": "color", "$value": "#0A0A0A" },
      "route-walk": { "$type": "color", "$value": "#6B6B6B" },
      "cluster-fill": { "$type": "color", "$value": "rgba(247, 209, 23, 0.18)" },
      "cluster-stroke": { "$type": "color", "$value": "#F7D117" }
    },
    "overlay": {
      "scrim": { "$type": "color", "$value": "rgba(10, 10, 10, 0.48)" },
      "sheet-shadow": { "$type": "color", "$value": "rgba(0, 0, 0, 0.10)" }
    },
    "naMe": {
      "red": { "$type": "color", "$value": "#FF1744" },
      "orange": { "$type": "color", "$value": "#FF9100" },
      "yellow": { "$type": "color", "$value": "#FFEA00" },
      "green": { "$type": "color", "$value": "#00E676" },
      "cyan": { "$type": "color", "$value": "#00E5FF" },
      "blue": { "$type": "color", "$value": "#2979FF" },
      "purple": { "$type": "color", "$value": "#D500F9" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    }
