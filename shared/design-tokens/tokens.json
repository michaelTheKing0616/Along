      "okada": { "$type": "color", "$value": "#2563EB" },
      "minibus": { "$type": "color", "$value": "#7C3AED" },
      "car-on": { "$type": "color", "$value": "#FFFFFF" },
      "keke-on": { "$type": "color", "$value": "#0A0A0A" },
      "okada-on": { "$type": "color", "$value": "#FFFFFF" },
      "minibus-on": { "$type": "color", "$value": "#FFFFFF" },
      "car-tint": { "$type": "color", "$value": "#CCFBF1" },
      "keke-tint": { "$type": "color", "$value": "#FFF6CC" },
      "okada-tint": { "$type": "color", "$value": "#DBEAFE" },
      "minibus-tint": { "$type": "color", "$value": "#EDE9FE" }
