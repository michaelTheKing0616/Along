  "typography": {
    "display": {
      "xl": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "40px",
          "lineHeight": "44px",
          "fontWeight": 700,
          "letterSpacing": "-0.03em",
          "fontFeatures": ["tnum"]
        }
      },
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "32px",
          "lineHeight": "36px",
          "fontWeight": 700,
          "letterSpacing": "-0.03em",
          "fontFeatures": ["tnum"]
        }
      }
    },
    "heading": {
      "1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "24px",
          "lineHeight": "30px",
          "fontWeight": 700,
          "letterSpacing": "-0.025em"
        }
      },
      "2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "20px",
          "lineHeight": "26px",
          "fontWeight": 700,
          "letterSpacing": "-0.02em"
        }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "18px",
        "lineHeight": "24px",
        "fontWeight": 600,
        "letterSpacing": "0em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 400,
        "letterSpacing": "0em"
      }
    },
    "body-strong": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 600,
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 600,
        "letterSpacing": "0em"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500,
        "letterSpacing": "0em"
      }
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Satoshi",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 700,
        "letterSpacing": "0.06em",
        "textTransform": "uppercase"
      }
    },
    "numeric": {
      "l": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "24px",
          "lineHeight": "28px",
          "fontWeight": 700,
          "letterSpacing": "-0.01em",
          "fontFeatures": ["tnum"]
        }
      },
      "m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "18px",
          "lineHeight": "22px",
          "fontWeight": 700,
          "letterSpacing": "0em",
          "fontFeatures": ["tnum"]
        }
      }
    },
    "button": {
      "primary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Satoshi",
          "fontSize": "17px",
          "lineHeight": "24px",
          "fontWeight": 700,
          "letterSpacing": "0em"
        }
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "sheet": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "touch-min": { "$type": "dimension", "$value": "48px" },
    "cta-primary": { "$type": "dimension", "$value": "56px" },
    "cta-secondary": { "$type": "dimension", "$value": "48px" },
    "chip": { "$type": "dimension", "$value": "36px" },
    "map-control": { "$type": "dimension", "$value": "44px" },
    "list-row-min": { "$type": "dimension", "$value": "56px" }
  },
  "shadow": {
    "sheet": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "-4px",
        "blur": "24px",
        "spread": "0px",
        "color": "{color.overlay.sheet-shadow}"
      }
    },
    "floating": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0px",
        "offsetY": "2px",
        "blur": "8px",
        "spread": "0px",
        "color": "rgba(0, 0, 0, 0.12)"
      }
    }
  },
  "motion": {
    "tap": { "$type": "duration", "$value": "120ms" },
    "sheet": { "$type": "duration", "$value": "220ms" },
    "route": { "$type": "duration", "$value": "200ms" },
    "camera": { "$type": "duration", "$value": "350ms" },
    "pulse": { "$type": "duration", "$value": "1600ms" },
    "na-me-on": { "$type": "duration", "$value": "250ms" },
    "na-me-cycle": { "$type": "duration", "$value": "8000ms" }
  },
  "easing": {
    "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
    "sheet": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "ease-in-out": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  }
}
