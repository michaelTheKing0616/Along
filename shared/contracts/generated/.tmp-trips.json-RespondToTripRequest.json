{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RespondToTripRequest",
  "type": "object",
  "required": [
    "p_trip_id",
    "p_action"
  ],
  "properties": {
    "p_trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_action": {
      "type": "string",
      "enum": [
        "accept",
        "decline"
      ]
    },
    "p_decline_reason": {
      "type": "string"
    }
  }
}