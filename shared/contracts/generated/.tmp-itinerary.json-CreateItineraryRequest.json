{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateItineraryRequest",
  "type": "object",
  "required": [
    "p_stops"
  ],
  "properties": {
    "p_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "destination_description"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "destination_description": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          }
        }
      }
    },
    "p_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "acknowledged_warning": {
          "type": "boolean"
        }
      }
    }
  }
}