{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error",
    "meta"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "NOT_FOUND",
            "VALIDATION",
            "CONFLICT",
            "RATE_LIMITED",
            "STATE_INVALID",
            "DRIVER_NOT_MATCHABLE",
            "LEDGER_BLOCKED",
            "CANDIDATE_EXPIRED",
            "NEGOTIATION_CLOSED",
            "FARE_UNRESOLVED",
            "COVERAGE_GAP",
            "DEGRADED_UPSTREAM",
            "IDEMPOTENT_REPLAY"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "degraded": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": "string"
        },
        "idempotent_replay": {
          "type": "boolean"
        }
      }
    }
  }
}