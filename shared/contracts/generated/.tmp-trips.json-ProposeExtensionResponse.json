{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProposeExtensionResponse",
  "type": "object",
  "required": [
    "extension_id",
    "fare_delta",
    "new_total",
    "tier",
    "unconfirmed"
  ],
  "properties": {
    "extension_id": {
      "type": "string",
      "format": "uuid"
    },
    "fare_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "new_total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "tier": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "unconfirmed": {
      "type": "boolean"
    }
  }
}