{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmbientCell",
  "type": "object",
  "required": [
    "cell",
    "centroid",
    "mode",
    "count_bucket",
    "heading_sectors",
    "serves_destination",
    "eta_band_s"
  ],
  "properties": {
    "cell": {
      "type": "string"
    },
    "centroid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "icon_key",
        "color_token"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon_key": {
          "type": "string"
        },
        "color_token": {
          "type": "string"
        }
      }
    },
    "count_bucket": {
      "type": "string",
      "enum": [
        "1-2",
        "3-5",
        "6+"
      ]
    },
    "heading_sectors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "serves_destination": {
      "type": "boolean"
    },
    "eta_band_s": {
      "type": "integer",
      "minimum": 0
    }
  }
}