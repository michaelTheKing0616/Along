{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuggestedStopPriceRequest",
  "type": "object",
  "required": [
    "p_profile_id",
    "p_sequence",
    "p_location"
  ],
  "properties": {
    "p_profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "p_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    }
  }
}