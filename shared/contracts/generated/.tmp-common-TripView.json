{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TripView",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trip_id",
    "journey_id",
    "journey_sequence",
    "status",
    "mode",
    "rider",
    "driver",
    "vehicle",
    "board",
    "alight",
    "route_leg_ids",
    "fare",
    "load",
    "women_only",
    "na_me",
    "live_channel",
    "expires_at",
    "timestamps"
  ],
  "properties": {
    "trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "journey_id": {
      "type": "string",
      "format": "uuid"
    },
    "journey_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string"
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "icon_key",
        "color_token"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon_key": {
          "type": "string"
        },
        "color_token": {
          "type": "string"
        }
      }
    },
    "rider": {
      "type": "object",
      "required": [
        "display_name",
        "rating",
        "trip_count"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "trip_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "driver": {
      "type": "object",
      "required": [
        "display_name",
        "rating",
        "trips_completed"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "trips_completed": {
          "type": "integer",
          "minimum": 0
        },
        "photo_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "vehicle": {
      "type": "object",
      "required": [
        "plate_number",
        "color",
        "make_model",
        "seat_capacity"
      ],
      "properties": {
        "plate_number": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "make_model": {
          "type": "string"
        },
        "seat_capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "board": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_id",
            "name",
            "location"
          ],
          "properties": {
            "stage_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lat",
                "lng"
              ],
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lng": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "walk_m",
            "walk_s",
            "wayfinding_available"
          ],
          "properties": {
            "walk_m": {
              "type": "integer",
              "minimum": 0
            },
            "walk_s": {
              "type": "integer",
              "minimum": 0
            },
            "wayfinding_available": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "alight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "name",
        "location"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    "route_leg_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "fare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "tier",
        "confidence",
        "unconfirmed",
        "components",
        "quote_id",
        "expires_at"
      ],
      "properties": {
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$"
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          }
        },
        "tier": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unconfirmed": {
          "type": "boolean"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "amount",
              "label"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "through_fare",
                  "leg",
                  "profile",
                  "estimate",
                  "load_surcharge",
                  "negotiated"
                ]
              },
              "ref_id": {
                "type": "string",
                "format": "uuid"
              },
              "amount": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$"
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  }
                }
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "quote_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "acknowledged_warning": {
          "type": "boolean"
        }
      }
    },
    "women_only": {
      "type": "boolean"
    },
    "na_me": {
      "type": "object",
      "required": [
        "color_token",
        "shape",
        "label"
      ],
      "properties": {
        "color_token": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "live_channel": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "date-time"
      }
    },
    "extension": {},
    "payment_method": {
      "type": "string"
    }
  }
}