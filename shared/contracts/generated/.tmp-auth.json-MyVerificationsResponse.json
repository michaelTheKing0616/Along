{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyVerificationsResponse",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "document_type",
      "status",
      "submitted_at"
    ],
    "properties": {
      "document_type": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "rejection_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "submitted_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}