{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresencePingRequest",
  "type": "object",
  "required": [
    "p_location",
    "p_heading",
    "p_speed_mps",
    "p_accuracy_m"
  ],
  "properties": {
    "p_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "p_heading": {
      "type": "number"
    },
    "p_speed_mps": {
      "type": "number",
      "minimum": 0
    },
    "p_accuracy_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "Rejected when > 500 m (doc 03 §0)."
    },
    "p_seats_available": {
      "type": "integer",
      "minimum": 0
    }
  }
}