{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmbientDemandCell",
  "type": "object",
  "required": [
    "cell",
    "centroid",
    "searches_last_15m_bucket",
    "top_destination_directions"
  ],
  "properties": {
    "cell": {
      "type": "string"
    },
    "centroid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "searches_last_15m_bucket": {
      "type": "string"
    },
    "top_destination_directions": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}