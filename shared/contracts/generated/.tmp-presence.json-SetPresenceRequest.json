{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SetPresenceRequest",
  "type": "object",
  "required": [
    "p_status",
    "p_location",
    "p_seats_available"
  ],
  "properties": {
    "p_status": {
      "type": "string",
      "enum": [
        "at_park",
        "roaming_available",
        "roaming_full",
        "offline"
      ]
    },
    "p_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "p_heading": {
      "type": "number"
    },
    "p_seats_available": {
      "type": "integer",
      "minimum": 0
    },
    "p_park_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_declared_route_profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_declared_route_leg_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}