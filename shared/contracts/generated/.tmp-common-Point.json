{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Point",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lat",
    "lng"
  ],
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  }
}