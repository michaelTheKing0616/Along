{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NegotiationRoundRequest",
  "type": "object",
  "required": [
    "p_negotiation_id",
    "p_action"
  ],
  "properties": {
    "p_negotiation_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_action": {
      "type": "string",
      "enum": [
        "accept",
        "counter",
        "decline"
      ]
    },
    "p_amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    }
  }
}