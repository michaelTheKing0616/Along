{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RateTripRequest",
  "type": "object",
  "required": [
    "p_trip_id",
    "p_score",
    "p_tags"
  ],
  "properties": {
    "p_trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "p_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "p_comment": {
      "type": "string",
      "maxLength": 500
    }
  }
}