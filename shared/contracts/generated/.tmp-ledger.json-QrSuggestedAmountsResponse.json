{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QrSuggestedAmountsResponse",
  "type": "array",
  "maxItems": 7,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "amount",
      "currency"
    ],
    "properties": {
      "amount": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d{1,2})?$"
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      }
    }
  }
}