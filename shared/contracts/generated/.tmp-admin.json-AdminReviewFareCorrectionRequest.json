{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminReviewFareCorrectionRequest",
  "type": "object",
  "required": [
    "id",
    "action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}