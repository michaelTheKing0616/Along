{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminCorridorAnalyticsRequest",
  "type": "object",
  "required": [
    "p_corridor_id",
    "p_from",
    "p_to"
  ],
  "properties": {
    "p_corridor_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_from": {
      "type": "string",
      "format": "date-time"
    },
    "p_to": {
      "type": "string",
      "format": "date-time"
    },
    "p_cursor": {
      "type": "string"
    },
    "p_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}