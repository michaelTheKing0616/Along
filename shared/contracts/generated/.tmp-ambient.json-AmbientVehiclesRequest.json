{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmbientVehiclesRequest",
  "type": "object",
  "required": [
    "p_lat",
    "p_lng",
    "p_radius_m"
  ],
  "properties": {
    "p_lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "p_lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "p_radius_m": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3000
    },
    "p_dest_lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "p_dest_lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  }
}