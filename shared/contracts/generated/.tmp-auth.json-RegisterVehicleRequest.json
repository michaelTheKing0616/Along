{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterVehicleRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode_code",
    "plate_number",
    "seat_capacity",
    "owner_is_me"
  ],
  "properties": {
    "mode_code": {
      "type": "string"
    },
    "plate_number": {
      "type": "string"
    },
    "seat_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "color": {
      "type": "string"
    },
    "make_model": {
      "type": "string"
    },
    "owner_is_me": {
      "type": "boolean"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    }
  }
}