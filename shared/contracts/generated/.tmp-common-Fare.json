{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fare",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "tier",
    "confidence",
    "unconfirmed",
    "components",
    "quote_id",
    "expires_at"
  ],
  "properties": {
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "tier": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "unconfirmed": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "amount",
          "label"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "through_fare",
              "leg",
              "profile",
              "estimate",
              "load_surcharge",
              "negotiated"
            ]
          },
          "ref_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "currency"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$"
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              }
            }
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "quote_id": {
      "type": "string",
      "format": "uuid"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}