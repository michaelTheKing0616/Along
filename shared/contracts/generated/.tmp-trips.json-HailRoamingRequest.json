{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HailRoamingRequest",
  "type": "object",
  "required": [
    "p_candidate_token",
    "p_destination",
    "p_women_only",
    "p_client_ref"
  ],
  "properties": {
    "p_candidate_token": {
      "type": "string"
    },
    "p_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "p_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "acknowledged_warning": {
          "type": "boolean"
        }
      }
    },
    "p_women_only": {
      "type": "boolean"
    },
    "p_client_ref": {
      "type": "string",
      "format": "uuid"
    }
  }
}