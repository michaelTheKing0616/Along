{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdateRiderPrefsRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "wayfinding_mode": {
      "type": "string",
      "enum": [
        "text",
        "map",
        "audio"
      ]
    },
    "saved_sort": {
      "type": "string",
      "enum": [
        "recommended",
        "cheapest",
        "fastest",
        "least_strenuous"
      ]
    },
    "women_only_pref": {
      "type": "boolean"
    }
  }
}