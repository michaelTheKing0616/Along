{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapStageResponse",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "required": [
        "stage_id",
        "name",
        "distance_m",
        "route_ids"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "route_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}