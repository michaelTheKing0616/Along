{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequestTripRequest",
  "type": "object",
  "required": [
    "p_candidate_id",
    "p_leg_index",
    "p_women_only",
    "p_client_ref"
  ],
  "properties": {
    "p_candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_leg_index": {
      "type": "integer",
      "minimum": 0
    },
    "p_load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "acknowledged_warning": {
          "type": "boolean"
        }
      }
    },
    "p_women_only": {
      "type": "boolean"
    },
    "p_client_ref": {
      "type": "string",
      "format": "uuid"
    }
  }
}