{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocationSamplePoint",
  "type": "object",
  "required": [
    "ts",
    "lat",
    "lng",
    "accuracy_m"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "accuracy_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "Rejected when > 500 m (doc 03 §0)."
    },
    "speed_mps": {
      "type": "number",
      "minimum": 0
    },
    "heading": {
      "type": "number"
    }
  }
}