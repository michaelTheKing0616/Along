{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenNegotiationResponse",
  "type": "object",
  "required": [
    "negotiation_id",
    "anchor",
    "chip_steps",
    "round_cap",
    "round_timeout_s",
    "eta_band",
    "expires_at"
  ],
  "properties": {
    "negotiation_id": {
      "type": "string",
      "format": "uuid"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "chip_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          }
        }
      }
    },
    "round_cap": {
      "type": "integer",
      "minimum": 1
    },
    "round_timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "eta_band": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}