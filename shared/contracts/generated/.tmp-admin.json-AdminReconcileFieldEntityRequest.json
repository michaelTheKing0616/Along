{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdminReconcileFieldEntityRequest",
  "type": "object",
  "required": [
    "p_reconciliation_id",
    "action"
  ],
  "properties": {
    "p_reconciliation_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "enum": [
        "match",
        "discrepant",
        "resolve"
      ]
    },
    "p_resolution": {
      "type": "string"
    }
  }
}