{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterDeviceTokenRequest",
  "type": "object",
  "required": [
    "platform",
    "token",
    "app"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "web"
      ]
    },
    "token": {
      "type": "string"
    },
    "app": {
      "type": "string",
      "enum": [
        "rider",
        "driver"
      ]
    }
  }
}