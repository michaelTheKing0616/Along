{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteProfileStop",
  "type": "object",
  "required": [
    "sequence"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "route_stage_id": {
      "type": "string",
      "format": "uuid"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "custom_label": {
      "type": "string"
    },
    "price_to_end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    }
  }
}