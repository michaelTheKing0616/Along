{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatePaymentRequestResponse",
  "type": "object",
  "required": [
    "url",
    "token",
    "amount",
    "expires_at"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "token": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$"
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}