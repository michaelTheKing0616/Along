{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapStageRequest",
  "type": "object",
  "required": [
    "p_lat",
    "p_lng"
  ],
  "properties": {
    "p_lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "p_lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  }
}