{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdateItineraryStopsRequest",
  "type": "object",
  "required": [
    "p_itinerary_id",
    "p_ops"
  ],
  "properties": {
    "p_itinerary_id": {
      "type": "string",
      "format": "uuid"
    },
    "p_ops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "reorder",
              "edit"
            ]
          }
        }
      }
    }
  }
}