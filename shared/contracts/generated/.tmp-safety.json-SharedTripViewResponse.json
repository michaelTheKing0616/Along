{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedTripViewResponse",
  "type": "object",
  "required": [
    "rider_first_name",
    "status",
    "mode",
    "vehicle",
    "driver_first_name",
    "current_location",
    "destination_label",
    "eta_s",
    "legs_progress"
  ],
  "properties": {
    "rider_first_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "label",
        "icon_key",
        "color_token"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon_key": {
          "type": "string"
        },
        "color_token": {
          "type": "string"
        }
      }
    },
    "vehicle": {
      "type": "object",
      "required": [
        "plate",
        "color"
      ],
      "properties": {
        "plate": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "driver_first_name": {
      "type": "string"
    },
    "current_location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "destination_label": {
      "type": "string"
    },
    "eta_s": {
      "type": "integer",
      "minimum": 0
    },
    "legs_progress": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}