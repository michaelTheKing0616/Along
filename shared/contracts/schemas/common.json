{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://along.ng/schemas/common.json",
  "title": "AlongCommon",
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "FareTier": { "type": "integer", "enum": [0, 1, 2, 3] },
    "FareComponentKind": {
      "type": "string",
      "enum": [
        "through_fare",
        "leg",
        "profile",
        "estimate",
        "load_surcharge",
        "negotiated"
      ]
    },
    "FareComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount", "label"],
      "properties": {
        "kind": { "$ref": "#/$defs/FareComponentKind" },
        "ref_id": { "type": "string", "format": "uuid" },
        "amount": { "$ref": "#/$defs/Money" },
        "label": { "type": "string" }
      }
    },
    "Fare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "tier",
        "confidence",
        "unconfirmed",
        "components",
        "quote_id",
        "expires_at"
      ],
      "properties": {
        "total": { "$ref": "#/$defs/Money" },
        "tier": { "$ref": "#/$defs/FareTier" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "unconfirmed": { "type": "boolean" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/FareComponent" }
        },
        "quote_id": { "type": "string", "format": "uuid" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ModeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "icon_key", "color_token"],
      "properties": {
        "code": { "type": "string" },
        "label": { "type": "string" },
        "icon_key": { "type": "string" },
        "color_token": { "type": "string" }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_fare",
        "total_time_s",
        "in_vehicle_s",
        "wait_s",
        "walk_s",
        "transfer_count",
        "total_walking_distance_m",
        "strenuousness_score",
        "recommended_score",
        "explain"
      ],
      "properties": {
        "total_fare": { "$ref": "#/$defs/Money" },
        "total_time_s": { "type": "integer", "minimum": 0 },
        "in_vehicle_s": { "type": "integer", "minimum": 0 },
        "wait_s": { "type": "integer", "minimum": 0 },
        "walk_s": { "type": "integer", "minimum": 0 },
        "transfer_count": { "type": "integer", "minimum": 0 },
        "total_walking_distance_m": { "type": "integer", "minimum": 0 },
        "strenuousness_score": { "type": "number", "minimum": 0 },
        "recommended_score": { "type": "number" },
        "explain": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "VALIDATION",
        "CONFLICT",
        "RATE_LIMITED",
        "STATE_INVALID",
        "DRIVER_NOT_MATCHABLE",
        "LEDGER_BLOCKED",
        "CANDIDATE_EXPIRED",
        "NEGOTIATION_CLOSED",
        "FARE_UNRESOLVED",
        "COVERAGE_GAP",
        "DEGRADED_UPSTREAM",
        "IDEMPOTENT_REPLAY"
      ]
    },
    "ResponseMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id"],
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "degraded": { "type": "boolean" },
        "next_cursor": { "type": "string" },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" },
        "details": {}
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "meta"],
      "properties": {
        "error": { "$ref": "#/$defs/ApiError" },
        "meta": { "$ref": "#/$defs/ResponseMeta" }
      }
    },
    "StageLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "name", "location"],
      "properties": {
        "stage_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "location": { "$ref": "#/$defs/Point" }
      }
    },
    "BoardStop": {
      "allOf": [
        { "$ref": "#/$defs/StageLocation" },
        {
          "type": "object",
          "required": ["walk_m", "walk_s", "wayfinding_available"],
          "properties": {
            "walk_m": { "type": "integer", "minimum": 0 },
            "walk_s": { "type": "integer", "minimum": 0 },
            "wayfinding_available": { "type": "boolean" }
          }
        }
      ]
    },
    "LoadFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flagged"],
      "properties": {
        "flagged": { "type": "boolean" },
        "size": {
          "type": "string",
          "enum": ["small", "medium", "large"]
        },
        "note": { "type": "string", "maxLength": 200 },
        "acknowledged_warning": { "type": "boolean" }
      }
    },
    "TripView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trip_id",
        "journey_id",
        "journey_sequence",
        "status",
        "mode",
        "rider",
        "driver",
        "vehicle",
        "board",
        "alight",
        "route_leg_ids",
        "fare",
        "load",
        "women_only",
        "na_me",
        "live_channel",
        "expires_at",
        "timestamps"
      ],
      "properties": {
        "trip_id": { "type": "string", "format": "uuid" },
        "journey_id": { "type": "string", "format": "uuid" },
        "journey_sequence": { "type": "integer", "minimum": 1 },
        "status": { "type": "string" },
        "mode": { "$ref": "#/$defs/ModeRef" },
        "rider": {
          "type": "object",
          "required": ["display_name", "rating", "trip_count"],
          "properties": {
            "display_name": { "type": "string" },
            "rating": { "type": "number" },
            "trip_count": { "type": "integer", "minimum": 0 }
          }
        },
        "driver": {
          "type": "object",
          "required": ["display_name", "rating", "trips_completed"],
          "properties": {
            "display_name": { "type": "string" },
            "rating": { "type": "number" },
            "trips_completed": { "type": "integer", "minimum": 0 },
            "photo_url": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "vehicle": {
          "type": "object",
          "required": ["plate_number", "color", "make_model", "seat_capacity"],
          "properties": {
            "plate_number": { "type": "string" },
            "color": { "type": "string" },
            "make_model": { "type": "string" },
            "seat_capacity": { "type": "integer", "minimum": 1 }
          }
        },
        "board": { "$ref": "#/$defs/BoardStop" },
        "alight": { "$ref": "#/$defs/StageLocation" },
        "route_leg_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        },
        "fare": { "$ref": "#/$defs/Fare" },
        "load": { "$ref": "#/$defs/LoadFlag" },
        "women_only": { "type": "boolean" },
        "na_me": {
          "type": "object",
          "required": ["color_token", "shape", "label"],
          "properties": {
            "color_token": { "type": "string" },
            "shape": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "live_channel": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" },
        "timestamps": {
          "type": "object",
          "additionalProperties": { "type": "string", "format": "date-time" }
        },
        "extension": {},
        "payment_method": { "type": "string" },
        "live": {
          "type": "object",
          "required": ["as_of"],
          "properties": {
            "as_of": { "type": "string", "format": "date-time" },
            "driver": { "$ref": "#/$defs/LivePosition" },
            "rider": { "$ref": "#/$defs/LivePosition" }
          }
        }
      }
    },
    "LivePosition": {
      "type": "object",
      "required": ["lat", "lng", "ts"],
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "heading": { "type": ["integer", "null"] },
        "speed_mps": { "type": ["number", "null"] },
        "ts": { "type": "string", "format": "date-time" }
      }
    },
    "CountBucket": {
      "type": "string",
      "enum": ["1-2", "3-5", "6+"]
    },
    "Uuid": { "type": "string", "format": "uuid" },
    "IsoDateTime": { "type": "string", "format": "date-time" },
    "GeoAccuracyM": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "description": "Rejected when > 500 m (doc 03 §0)."
    },
    "CursorLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
