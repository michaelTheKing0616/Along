{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://along.ng/schemas/rpc/ambient.json",
  "title": "AmbientDiscoveryRpc",
  "$defs": {
    "AmbientVehiclesRequest": {
      "type": "object",
      "required": ["p_lat", "p_lng", "p_radius_m"],
      "properties": {
        "p_lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "p_lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "p_radius_m": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "p_dest_lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "p_dest_lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "AmbientCell": {
      "type": "object",
      "required": [
        "cell",
        "centroid",
        "mode",
        "count_bucket",
        "heading_sectors",
        "serves_destination",
        "eta_band_s"
      ],
      "properties": {
        "cell": { "type": "string" },
        "centroid": { "$ref": "../common.json#/$defs/Point" },
        "mode": { "$ref": "../common.json#/$defs/ModeRef" },
        "count_bucket": { "$ref": "../common.json#/$defs/CountBucket" },
        "heading_sectors": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 0 }
        },
        "serves_destination": { "type": "boolean" },
        "eta_band_s": { "type": "integer", "minimum": 0 }
      }
    },
    "AmbientVehiclesResponse": {
      "type": "object",
      "required": ["as_of", "cells"],
      "properties": {
        "as_of": { "$ref": "../common.json#/$defs/IsoDateTime" },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/AmbientCell" }
        }
      }
    },
    "AmbientDemandRequest": {
      "type": "object",
      "required": ["p_lat", "p_lng", "p_radius_m"],
      "properties": {
        "p_lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "p_lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "p_radius_m": { "type": "integer", "minimum": 1, "maximum": 3000 }
      }
    },
    "AmbientDemandCell": {
      "type": "object",
      "required": ["cell", "centroid", "searches_last_15m_bucket", "top_destination_directions"],
      "properties": {
        "cell": { "type": "string" },
        "centroid": { "$ref": "../common.json#/$defs/Point" },
        "searches_last_15m_bucket": { "type": "string" },
        "top_destination_directions": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "AmbientDemandResponse": {
      "type": "object",
      "required": ["cells"],
      "properties": {
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/AmbientDemandCell" }
        }
      }
    }
  }
}
