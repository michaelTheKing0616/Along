{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://along.ng/schemas/rpc/auth.json",
  "title": "AuthAndProfileRpc",
  "$defs": {
    "CompleteRiderOnboardingRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string", "maxLength": 80 },
        "home_city_id": { "$ref": "../common.json#/$defs/Uuid" }
      }
    },
    "StartDriverOnboardingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city_id", "display_name"],
      "properties": {
        "city_id": { "$ref": "../common.json#/$defs/Uuid" },
        "display_name": { "type": "string", "maxLength": 80 },
        "gender": { "type": "string" }
      }
    },
    "RegisterVehicleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_code", "plate_number", "seat_capacity", "owner_is_me"],
      "properties": {
        "mode_code": { "type": "string" },
        "plate_number": { "type": "string" },
        "seat_capacity": { "type": "integer", "minimum": 1 },
        "color": { "type": "string" },
        "make_model": { "type": "string" },
        "owner_is_me": { "type": "boolean" },
        "owner_name": { "type": "string" },
        "owner_phone": { "type": "string" }
      }
    },
    "RegisterVehicleResponse": {
      "type": "object",
      "required": ["vehicle_id"],
      "properties": {
        "vehicle_id": { "$ref": "../common.json#/$defs/Uuid" }
      }
    },
    "SubmitVerificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "storage_path"],
      "properties": {
        "vehicle_id": { "$ref": "../common.json#/$defs/Uuid" },
        "document_type": { "type": "string" },
        "storage_path": { "type": "string" },
        "client_ocr_hint": { "type": "string" }
      }
    },
    "MyVerificationsResponse": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_type", "status", "submitted_at"],
        "properties": {
          "document_type": { "type": "string" },
          "status": { "type": "string" },
          "rejection_reason": { "type": ["string", "null"] },
          "submitted_at": { "$ref": "../common.json#/$defs/IsoDateTime" }
        }
      }
    },
    "RegisterDeviceTokenRequest": {
      "type": "object",
      "required": ["platform", "token", "app"],
      "properties": {
        "platform": { "type": "string", "enum": ["ios", "android", "web"] },
        "token": { "type": "string" },
        "app": { "type": "string", "enum": ["rider", "driver"] }
      }
    },
    "UpdateRiderPrefsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wayfinding_mode": { "type": "string", "enum": ["text", "map", "audio"] },
        "saved_sort": {
          "type": "string",
          "enum": ["recommended", "cheapest", "fastest", "least_strenuous"]
        },
        "women_only_pref": { "type": "boolean" }
      }
    },
    "RegisterGuarantorRequest": {
      "type": "object",
      "required": ["guarantor_type", "name", "phone_e164"],
      "properties": {
        "guarantor_type": { "type": "string" },
        "name": { "type": "string" },
        "phone_e164": { "type": "string" },
        "profile_id": { "$ref": "../common.json#/$defs/Uuid" }
      }
    },
    "AcknowledgeGuarantorRequest": {
      "type": "object",
      "required": ["p_token"],
      "properties": {
        "p_token": { "type": "string" }
      }
    },
    "AcknowledgeGuarantorResponse": {
      "type": "object",
      "required": ["acknowledged_at"],
      "properties": {
        "acknowledged_at": { "$ref": "../common.json#/$defs/IsoDateTime" }
      }
    }
  }
}
